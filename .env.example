# Copy to .env. HF token is needed for the gated pyannote diarization models:
# 1) create a token at https://huggingface.co/settings/tokens (read scope)
# 2) accept the terms on https://huggingface.co/pyannote/speaker-diarization-community-1
#    and https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=
# Where the SQLite db, converted audio and clips live (default ./data)
VOICEFLOCK_DATA_DIR=./data
# cpu | cuda | mps | auto
VOICEFLOCK_DEVICE=auto
